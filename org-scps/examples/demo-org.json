  "policies": [
    {
      "id": "p-FullAWSAccess",
      "name": "FullAWSAccess",
      "type": "SERVICE_CONTROL_POLICY",
      "description": "Allows access to every operation",
      "aws_managed": true,
      "content": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": \"*\",\n      \"Resource\": \"*\"\n    }\n  ]\n}",
      "error": ""
    },
    {
      "id": "p-RCPFullAWSAccess",
      "name": "RCPFullAWSAccess",
      "type": "RESOURCE_CONTROL_POLICY",
      "description": "Allows access to every resource",
      "aws_managed": true,
      "content": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Effect\": \"Allow\",\n      \"Principal\": \"*\",\n      \"Action\": \"*\",\n      \"Resource\": \"*\"\n    }\n  ]\n}",
      "error": ""
    },
    {
      "id": "p-dl7q2m4x",
      "name": "deny-leave-org",
      "type": "SERVICE_CONTROL_POLICY",
      "description": "Accounts can't leave the organization",
      "aws_managed": false,
      "content": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"NoLeaving\",\n      \"Effect\": \"Deny\",\n      \"Action\": \"organizations:LeaveOrganization\",\n      \"Resource\": \"*\"\n    }\n  ]\n}",
      "error": ""
    },
    {
      "id": "p-nu6t1r8y",
      "name": "no-iam-users",
      "type": "SERVICE_CONTROL_POLICY",
      "description": "Use Identity Center and roles, not IAM users",
      "aws_managed": false,
      "content": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"NoLongLivedKeys\",\n      \"Effect\": \"Deny\",\n      \"Action\": [\n        \"iam:CreateUser\",\n        \"iam:CreateAccessKey\"\n      ],\n      \"Resource\": \"*\"\n    }\n  ]\n}",
      "error": ""
    },
    {
      "id": "p-pd3h7j9k",
      "name": "prod-no-deletes",
      "type": "SERVICE_CONTROL_POLICY",
      "description": "Only break-glass can delete data stores in prod",
      "aws_managed": false,
      "content": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"ProtectData\",\n      \"Effect\": \"Deny\",\n      \"Action\": [\n        \"s3:DeleteBucket\",\n        \"rds:DeleteDBInstance\",\n        \"rds:DeleteDBCluster\",\n        \"dynamodb:DeleteTable\"\n      ],\n      \"Resource\": \"*\",\n      \"Condition\": {\n        \"StringNotLike\": {\n          \"aws:PrincipalArn\": \"arn:aws:iam::*:role/break-glass\"\n        }\n      }\n    }\n  ]\n}",
      "error": ""
    },
    {
      "id": "p-ps8k3n5w",
      "name": "protect-security-tools",
      "type": "SERVICE_CONTROL_POLICY",
      "description": "Only the org access role can turn off logging",
      "aws_managed": false,
      "content": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"KeepLoggingOn\",\n      \"Effect\": \"Deny\",\n      \"Action\": [\n        \"cloudtrail:StopLogging\",\n        \"cloudtrail:DeleteTrail\",\n        \"cloudtrail:UpdateTrail\",\n        \"guardduty:DeleteDetector\",\n        \"config:StopConfigurationRecorder\",\n        \"config:DeleteConfigurationRecorder\"\n      ],\n      \"Resource\": \"*\",\n      \"Condition\": {\n        \"StringNotLike\": {\n          \"aws:PrincipalArn\": \"arn:aws:iam::*:role/OrganizationAccountAccessRole\"\n        }\n      }\n    }\n  ]\n}",
      "error": ""
    },
    {
      "id": "p-rc5m8n1q",
      "name": "s3-https-only",
      "type": "RESOURCE_CONTROL_POLICY",
      "description": "S3 requests have to use HTTPS",
      "aws_managed": false,
      "content": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"DenyPlainHttp\",\n      \"Effect\": \"Deny\",\n      \"Principal\": \"*\",\n      \"Action\": \"s3:*\",\n      \"Resource\": \"*\",\n      \"Condition\": {\n        \"Bool\": {\n          \"aws:SecureTransport\": \"false\"\n        }\n      }\n    }\n  ]\n}",
      "error": ""
    },
    {
      "id": "p-rl4v9c2b",
      "name": "region-lock",
      "type": "SERVICE_CONTROL_POLICY",
      "description": "Workloads run in us-east-1 and us-west-2 only",
      "aws_managed": false,
      "content": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"OnlyTwoRegions\",\n      \"Effect\": \"Deny\",\n      \"NotAction\": [\n        \"iam:*\",\n        \"organizations:*\",\n        \"sts:*\",\n        \"support:*\",\n        \"budgets:*\",\n        \"ce:*\",\n        \"cloudfront:*\",\n        \"route53:*\"\n      ],\n      \"Resource\": \"*\",\n      \"Condition\": {\n        \"StringNotEquals\": {\n          \"aws:RequestedRegion\": [\n            \"us-east-1\",\n            \"us-west-2\"\n          ]\n        }\n      }\n    }\n  ]\n}",
      "error": ""
    },
    {
      "id": "p-sa2w6e4r",
      "name": "sandbox-allow-list",
      "type": "SERVICE_CONTROL_POLICY",
      "description": "Sandbox gets a short list of services",
      "aws_managed": false,
      "content": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"SandboxServices\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ec2:*\",\n        \"s3:*\",\n        \"lambda:*\",\n        \"logs:*\",\n        \"cloudwatch:*\",\n        \"dynamodb:*\",\n        \"iam:Get*\",\n        \"iam:List*\",\n        \"sts:*\"\n      ],\n      \"Resource\": \"*\"\n    }\n  ]\n}",
      "error": ""
    }
  ],
