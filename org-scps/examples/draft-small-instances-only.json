{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SmallInstancesOnly",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringNotLike": {
          "ec2:InstanceType": ["t3.*", "t4g.*"]
        }
      }
    }
  ]
}
